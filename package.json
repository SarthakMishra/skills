{
  "name": "agent-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Personal collection of reusable skills for AI agents.",
  "license": "MIT",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern .",
    "check": "pnpm run format:check && pnpm run lint"
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.24.0"
}
